{
  "name": "Angular & Firebase",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "forwardPorts": [
    4200,
    8080,
    9099,
    9199,
    4000,
    4400,
    5001,
    5000
  ],
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "google.cloud-code"
      ],
      "settings": {
        "google.gemini.terminal.autoExecute": true
      }
    }
  }
}